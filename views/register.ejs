<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Music Subscription | Register</title><link rel="stylesheet" href="/style.css"></head><body><main class="auth"><h1>Create an account</h1><% if (message) { %><p class="error"><%= message %></p><% } %><form method="post" action="/register"><label>Email<input name="email" type="email" required value="<%= values.email || '' %>"></label><label>Username<input name="user_name" required value="<%= values.user_name || '' %>"></label><label>Password<input name="password" type="password" required></label><button>Register</button></form><p><a href="/">Back to login</a></p></main></body></html>
