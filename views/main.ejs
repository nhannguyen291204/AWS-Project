<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Music Subscription</title><link rel="stylesheet" href="/style.css"></head><body><header><h1>Music Subscription</h1><div>Welcome, <strong><%= user.userName %></strong> <form class="inline" method="post" action="/logout"><button class="link">Logout</button></form></div></header><main class="layout"><section><h2>Your subscriptions</h2><% if (!subscriptions.length) { %><p class="muted">No subscriptions yet.</p><% } %><div class="cards"><% subscriptions.forEach((song) => { %><article class="card"><img src="<%= song.image %>" alt="Artist for <%= song.title %>"><div><h3><%= song.title %></h3><p><%= song.artist %> · <%= song.year %></p><form method="post" action="/remove"><input type="hidden" name="title" value="<%= song.title %>"><button class="danger">Remove</button></form></div></article><% }) %></div></section><section class="query"><h2>Find music</h2><form method="post" action="/query" class="filters"><label>Title<input name="title" value="<%= filters.title || '' %>"></label><label>Year<input name="year" value="<%= filters.year || '' %>"></label><label>Artist<input name="artist" value="<%= filters.artist || '' %>"></label><button>Query</button></form><% if (message) { %><p class="error"><%= message %></p><% } %><% if (results) { %><div class="cards"><% results.forEach((song) => { %><article class="card"><img src="<%= song.image %>" alt="Artist for <%= song.title %>"><div><h3><%= song.title %></h3><p><%= song.artist %> · <%= song.year %></p><a href="<%= song.web_url %>" target="_blank" rel="noreferrer">Open in Spotify</a><form method="post" action="/subscribe"><input type="hidden" name="title" value="<%= song.title %>"><button>Subscribe</button></form></div></article><% }) %></div><% } %></section></main></body></html>
