# Copy file nay thanh .env, sau do dien cac gia tri cua ban vao.
# KHONG BAO GIO commit file .env hay chia se AWS keys len GitHub.

# AWS Academy Learner Lab Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SESSION_TOKEN=your_aws_session_token_here

# Ten S3 Bucket (viet thuong, duy nhat tren toan cau)
S3_BUCKET_NAME=your-unique-s3-bucket-name

# Ten bang DynamoDB (Mac dinh)
LOGIN_TABLE_NAME=login
MUSIC_TABLE_NAME=music
SUBSCRIPTION_TABLE_NAME=subscription

# Thiet lap Server
PORT=3000
SESSION_SECRET=replace-with-a-long-random-local-value

# Thong tin sinh vien
STUDENT_ID=s300000
FIRST_NAME=Firstname
LAST_NAME=Lastname
